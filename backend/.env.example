PORT=3001
CORS_ORIGIN=https://ball.boyzi.fun,https://ball.boyzi.top,https://localhost,capacitor://localhost,ionic://localhost,https://beta-wzja.world-cup-2026-625.pages.dev,https://world-cup-2026-625.pages.dev

# Public Polymarket market data does not need an API key today.
# Keep this reserved for future authenticated endpoints.
POLYMARKET_API_KEY=

# API-Football / API-SPORTS gateway.
# Used by /api/football/* endpoints for live scores, lineups, stats,
# standings, injuries, players, and historical matches.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=https://v3.football.api-sports.io
API_FOOTBALL_CACHE_TTL_MS=30000

# VPS World Cup cache warmer.
WORLDCUP_CACHE_FILE=../data/worldcup-cache.json
WORLDCUP_CACHE_LIVE_INTERVAL_MS=60000
WORLDCUP_CACHE_FOOTBALL_INTERVAL_MS=300000
WORLDCUP_CACHE_NEWS_INTERVAL_MS=600000
WORLDCUP_CACHE_UPCOMING_LIMIT=20
WORLDCUP_RSS_FEEDS=https://www.fifa.com/fifaplus/en/tournaments/mens/worldcup/canadamexicousa2026/rss.xml

# X / Twitter API v2 bearer token for player timeline cards and backend runtime status.
X_BEARER_TOKEN=
X_API_TIMEOUT_MS=10000
X_TIMELINE_CACHE_SECONDS=120
X_TIMELINE_MAX_PLAYERS=12
X_TIMELINE_MAX_RESULTS=5
X_PLAYER_HANDLES_JSON={}

# Email verification / transactional email.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
PUBLIC_APP_URL=https://your-frontend-domain.example

# Linux.do OIDC login.
LINUXDO_OIDC_CLIENT_ID=
LINUXDO_OIDC_CLIENT_SECRET=
LINUXDO_OIDC_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_OIDC_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_OIDC_USER_URL=https://connect.linux.do/api/user
LINUXDO_OIDC_REDIRECT_URI=https://api.boyzi.top/api/auth/linuxdo/callback
LINUXDO_OIDC_SCOPE=openid profile email

# GitHub OAuth login.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_USER_URL=https://api.github.com/user
GITHUB_OAUTH_EMAILS_URL=https://api.github.com/user/emails
GITHUB_OAUTH_REDIRECT_URI=https://api.boyzi.top/api/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email
PUBLIC_API_URL=https://your-api-domain.example

# WeChat Official Account JS-SDK share card signature.
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# Telegram bot notification channel.
# Create a bot with BotFather, set TELEGRAM_BOT_TOKEN here, and optionally set TELEGRAM_BOT_USERNAME for deep links.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
